# ---------------------------------------------------------------------------
# AgroTrace backend
# Copia este archivo a `.env` y rellena los valores.
# ---------------------------------------------------------------------------

# Clave para firmar los JWT. En produccion usa un valor largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGROTRACE_SECRET_KEY=dev-only-change-me

# Base de datos. SQLite por defecto; para Postgres:
#   postgresql+psycopg://user:pass@host:5432/agrotrace
AGROTRACE_DATABASE_URL=sqlite:///./agrotrace.db

# Origenes permitidos para CORS (separados por coma)
AGROTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL publica del frontend, usada para construir el contenido de los QR
AGROTRACE_PUBLIC_WEB_URL=http://localhost:5173

# --- Gemini -----------------------------------------------------------------
# Obten una API key en https://aistudio.google.com/apikey
# Sin key la app funciona igual, pero los agentes devuelven contenido de respaldo.
GEMINI_API_KEY=

# Modelos.
# Los alias "-latest" siguen apuntando al ultimo modelo estable de su familia, asi
# que la app no se rompe cuando Google retira una version concreta. Si prefieres
# fijar una version reproducible, usa un nombre exacto (p. ej. gemini-3.8-flash) y
# revisa `GET /api/v1/ai/status` tras cada cambio.
AGROTRACE_GEMINI_MODEL=gemini-flash-latest
AGROTRACE_GEMINI_MODEL_PRO=gemini-pro-latest

# Se usa si el principal devuelve un error transitorio (503 por demanda, 429 por
# cuota) despues de agotar los reintentos.
AGROTRACE_GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
AGROTRACE_GEMINI_MAX_RETRIES=3

# Tope de cada llamada y presupuesto total de la operacion completa (todos los
# reintentos y ambos modelos). Evita que una caida del servicio cuelgue la
# peticion HTTP: al agotarse se responde con el contenido de respaldo.
AGROTRACE_GEMINI_TIMEOUT_SECONDS=20
AGROTRACE_GEMINI_DEADLINE_SECONDS=45

# --- Vertex AI (opcional) ---------------------------------------------------
# El SDK google-genai es el mismo cliente para Gemini API y Vertex AI.
# Para migrar a Vertex no hay que tocar codigo: pon true y rellena project/location,
# y autenticate con `gcloud auth application-default login`.
AGROTRACE_USE_VERTEX=false
AGROTRACE_GCP_PROJECT=
AGROTRACE_GCP_LOCATION=us-central1

# --- Correo saliente (opcional) ---------------------------------------------
# Notificaciones de mensajes de compradores y enlaces de recuperar contrasena.
# Sin AGROTRACE_SMTP_HOST, los correos se registran en el log en vez de
# enviarse -- la app funciona igual, solo que el mensaje no sale de verdad.
# Ejemplo con Gmail: host smtp.gmail.com, puerto 587, usa una "contrasena de
# aplicacion" (no la contrasena normal de la cuenta).
AGROTRACE_SMTP_HOST=
AGROTRACE_SMTP_PORT=587
AGROTRACE_SMTP_USER=
AGROTRACE_SMTP_PASSWORD=
AGROTRACE_SMTP_FROM=AgroTrace <no-responder@agrotrace.local>
AGROTRACE_SMTP_USE_TLS=true

# --- Fotos de evidencia (opcional) ------------------------------------------
# Sin AGROTRACE_S3_BUCKET, las fotos se guardan en disco local
# (backend/uploads/). Funciona bien para desarrollo, pero la mayoria de
# plataformas en la nube borran ese disco en cada despliegue -- produccion
# necesita esto configurado con un bucket compatible con S3.
#
# Cloudflare R2 (recomendado, capa gratuita real sin costo de egreso):
#   1. Crea un bucket en dash.cloudflare.com > R2
#   2. Activa acceso publico al bucket (o conecta un dominio propio) y copia
#      esa URL publica en AGROTRACE_S3_PUBLIC_BASE_URL
#   3. Crea un token de API con permiso de lectura/escritura sobre ese bucket
#   4. AGROTRACE_S3_ENDPOINT_URL = https://<account_id>.r2.cloudflarestorage.com
AGROTRACE_S3_ENDPOINT_URL=
AGROTRACE_S3_ACCESS_KEY_ID=
AGROTRACE_S3_SECRET_ACCESS_KEY=
AGROTRACE_S3_BUCKET=
AGROTRACE_S3_REGION=auto
AGROTRACE_S3_PUBLIC_BASE_URL=

# Siembra datos de demostracion al arrancar (finca, producto y cadena de eventos).
# En produccion, ponlo en false: no tiene sentido que una cuenta demo publica
# convivera con usuarios reales.
AGROTRACE_SEED_DEMO=true
